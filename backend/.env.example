# Copy to backend/.env. Existing process environment variables take precedence.
DEVPULSE_ENVIRONMENT=development
DEVPULSE_LOG_LEVEL=INFO
DEVPULSE_API_DOCS_ENABLED=true
# Replace the placeholder and percent-encode special characters in the password.
DEVPULSE_DATABASE_URL=postgresql+psycopg://devpulse:REPLACE_ME@127.0.0.1:5432/devpulse
