# Copy to backend/.env. Existing process environment variables take precedence.
DEVPULSE_ENVIRONMENT=development
DEVPULSE_LOG_LEVEL=INFO
DEVPULSE_API_DOCS_ENABLED=true
# Empty by default. Exact loopback test destinations only; forbidden in production.
DEVPULSE_PROBE_FIXTURE_DESTINATIONS=[]
# Replace the placeholder and percent-encode special characters in the password.
DEVPULSE_DATABASE_URL=postgresql+psycopg://devpulse:REPLACE_ME@127.0.0.1:5432/devpulse
# Exact browser origin, used to validate all state-changing auth requests.
DEVPULSE_APP_ORIGIN=http://localhost:3000
# Local Mailpit. Production requires starttls or tls and an HTTPS app origin.
DEVPULSE_SMTP_HOST=127.0.0.1
DEVPULSE_SMTP_PORT=1025
DEVPULSE_SMTP_MODE=plain
DEVPULSE_MAIL_FROM=devpulse@localhost.localdomain
# Configure both only when the SMTP server requires authentication over TLS.
# DEVPULSE_SMTP_USERNAME=REPLACE_ME
# DEVPULSE_SMTP_PASSWORD=REPLACE_ME
